# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins. Use * only for local experiments.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/tasks_db?schema=public

# Request body size limit (Express)
BODY_LIMIT=100kb
